+import api from './client';
+
+/**
+ * Chat between a guest and the hotel, tied to one booking.
+ * Server side: GET/POST /api/customer/bookings/:id/messages and POST .../messages/read.
+ * If the server doesn't have these yet (404/501) the chat reports itself as unavailable instead of failing.
+ */
+export interface ChatMessage {
+  id: string;
+  from: 'guest' | 'hotel';
+  body: string;
+  at: string; // ISO time
+  read: boolean;
+}
+
+export interface Thread {
+  available: boolean;
+  messages: ChatMessage[];
+}
+
+interface ApiMessage {
+  id: string;
+  sender: 'partner' | 'guest';
+  body: string;
+  created_at: string;
+  read_at?: string | null;
+}
+
+function isMissing(err: unknown): boolean {
+  const status = (err as { response?: { status?: number } })?.response?.status;
+  return status === 404 || status === 501;
+}
+
+export async function fetchThread(bookingId: string): Promise<Thread> {
+  try {
+    const res = await api.get<{ data: ApiMessage[] }>(`/api/customer/bookings/${encodeURIComponent(bookingId)}/messages`);
+    const rows = Array.isArray(res.data?.data) ? res.data.data : [];
+    return {
+      available: true,
+      messages: rows
+        .map((m): ChatMessage => ({
+          id: String(m.id),
+          from: m.sender === 'guest' ? 'guest' : 'hotel',
+          body: String(m.body ?? ''),
+          at: m.created_at,
+          read: !!m.read_at,
+        }))
+        .sort((a, b) => new Date(a.at).getTime() - new Date(b.at).getTime()),
+    };
+  } catch (err) {
+    if (isMissing(err)) return { available: false, messages: [] };
+    throw err;
+  }
+}
+
+export async function sendMessage(bookingId: string, body: string): Promise<void> {
+  await api.post(`/api/customer/bookings/${encodeURIComponent(bookingId)}/messages`, { body });
+}
+
+export async function markThreadRead(bookingId: string): Promise<void> {
+  await api.post(`/api/customer/bookings/${encodeURIComponent(bookingId)}/messages/read`, {});
+}
+
+/** Hotel messages the guest has not read yet. */
+export function countUnread(messages: ChatMessage[]): number {
+  return messages.filter((m) => m.from === 'hotel' && !m.read).length;
+}
+
+/** Turns a failed request into something a guest can read. */
+export function errorText(err: unknown): string {
+  const e = err as { response?: { data?: { error?: string; message?: string } }; message?: string };
+  return e?.response?.data?.error || e?.response?.data?.message || 'Could not send. Check your connection and try again.';
+}
